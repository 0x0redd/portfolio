# Webhooky — full endpoint URL from the app (secret is in the URL)
WEBHOOKY_URL=https://api.webhooky.app/YOUR_KEY

# Optional: only notify when GPU string contains "A19 Pro" (skip screen-only matches)
# WEBHOOKY_IPHONE17_PRO_STRICT=1

# Protects /api/cron/daily-views (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=generate-a-long-random-string