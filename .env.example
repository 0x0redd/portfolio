# Google Sheets — views tab (same spreadsheet as before)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Optional overrides (defaults match the previous portfolio sheet)
# GOOGLE_VIEWS_SHEET_ID=17PT7eF7NbNythiSCyRyYeE6UDVtuPGXzGQu1JVbaO0E
